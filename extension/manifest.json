{
  "manifest_version": 3,
  "name": "Workana Radar Bid Bot",
  "version": "4.2.0",
  "description": "Takes projects one by one from your Supabase database, writes a proposal with OpenAI, sends it on Workana, and marks the project bidded. Opens in Chrome's side panel next to the Workana page.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://www.workana.com/*",
    "https://api.openai.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Workana Radar Bid Bot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.workana.com/messages/*",
        "https://www.workana.com/es/messages/*",
        "https://www.workana.com/pt/messages/*",
        "https://www.workana.com/inbox/*",
        "https://www.workana.com/es/inbox/*",
        "https://www.workana.com/pt/inbox/*"
      ],
      "js": [
        "content/workana-question.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114",
  "side_panel": {
    "default_path": "panel/panel.html"
  }
}
