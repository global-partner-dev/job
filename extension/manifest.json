{
  "manifest_version": 3,
  "name": "Workana Radar AskBot",
  "version": "3.0.0",
  "description": "Writes an OpenAI clarifying question for the newest Workana projects and opens each one pre-filled on Workana's \"Ask a question\" form — you press Send.",
  "permissions": ["storage", "cookies", "tabs"],
  "host_permissions": [
    "https://www.workana.com/*",
    "https://api.openai.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Workana Radar AskBot"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://job-six-nu.vercel.app/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.workana.com/messages/*",
        "https://www.workana.com/es/messages/*",
        "https://www.workana.com/pt/messages/*",
        "https://www.workana.com/inbox/*",
        "https://www.workana.com/es/inbox/*",
        "https://www.workana.com/pt/inbox/*"
      ],
      "js": ["content/workana-question.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
