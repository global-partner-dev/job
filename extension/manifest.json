{
  "manifest_version": 3,
  "name": "Workana Radar BidBot",
  "version": "2.0.0",
  "description": "Places Workana bids (proposal + OpenAI-computed price + delivery) for projects you select in the Workana Radar dashboard.",
  "permissions": ["storage", "cookies", "tabs"],
  "host_permissions": [
    "https://www.workana.com/*",
    "https://api.openai.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Workana Radar BidBot"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://job-six-nu.vercel.app/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.workana.com/messages/bid/*",
        "https://www.workana.com/es/messages/bid/*",
        "https://www.workana.com/pt/messages/bid/*",
        "https://www.workana.com/inbox/*",
        "https://www.workana.com/es/inbox/*",
        "https://www.workana.com/pt/inbox/*"
      ],
      "js": ["content/workana-bid.js", "content/workana-fill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
