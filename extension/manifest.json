{
  "manifest_version": 3,
  "name": "Workana Auto Bid Bot",
  "version": "1.1.0",
  "description": "Monitors workana-bot dashboard and places full Workana bids (proposal + amount + delivery) via OpenAI.",
  "permissions": ["storage", "alarms", "notifications", "cookies", "tabs"],
  "host_permissions": [
    "https://workana-bot.fly.dev/*",
    "https://www.workana.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Workana Auto Bid Bot"
  },
  "content_scripts": [
    {
      "matches": ["https://workana-bot.fly.dev/*"],
      "js": ["content/dashboard.js"],
      "css": ["content/dashboard.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.workana.com/messages/bid/*",
        "https://www.workana.com/es/messages/bid/*",
        "https://www.workana.com/pt/messages/bid/*",
        "https://www.workana.com/inbox/*",
        "https://www.workana.com/es/inbox/*",
        "https://www.workana.com/pt/inbox/*"
      ],
      "js": ["content/workana-bid.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
