# --- Supabase (required) -----------------------------------------------------
# Project URL and the SECRET key (Dashboard → Settings → API Keys).
# The secret key (legacy name: service_role) bypasses RLS — keep it secret.
# It belongs ONLY in this scraper's .env; the extension uses the publishable key,
# which you type into its side panel instead.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# --- AI category filter (optional) ------------------------------------------
# The scraper does NOT translate or summarize: project details are stored as
# posted. OpenAI is used for one yes/no call per new project (is it a target
# project type?). Leave the key empty and set AI_CATEGORY_FILTER=0 to skip it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# AI_CATEGORY_FILTER=1

# --- Client stats ------------------------------------------------------------
# A new project is stored only once its page has been read and the client's
# published/paid counts are known, so non-payers (2+ published, 0 paid) are
# always filtered out. Unreadable pages are retried on the next run.
# Set to 0 to store such projects without that check (not recommended).
# REQUIRE_CLIENT_STATS=1
