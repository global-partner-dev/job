# --- Supabase (required) -----------------------------------------------------
# Project URL and the SERVICE ROLE key (Dashboard → Settings → API).
# The service_role key bypasses RLS — keep it secret, never ship it to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional enrichment -----------------------------------------------------
# Google Cloud Translation API key (translates jobs to English before storing)
GOOGLE_TRANSLATE_API_KEY=

# OpenAI API key for the AI analysis summary shown in the web app
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
